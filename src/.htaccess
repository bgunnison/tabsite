# Optional Apache protection against indexing and directory browsing.
# This is NOT authentication. For private access, enable directory password
# protection in your hosting control panel for the entire /tabsite directory.
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
